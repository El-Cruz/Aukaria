# 1. Base de Datos Neon PostgreSQL (SSL Obligatorio)
# Formato URI o ADO.NET Npgsql
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-cool-resonance-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
ConnectionStrings__DefaultConnection="Host=ep-cool-resonance-123456.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=TU_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Include Error Detail=true;"

# 2. Motor de Inteligencia Artificial (Anthropic Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-api03-TU_CLAUDE_API_KEY_AQUI
Claude__ApiKey=sk-ant-api03-TU_CLAUDE_API_KEY_AQUI
Anthropic__ApiKey=sk-ant-api03-TU_CLAUDE_API_KEY_AQUI
Anthropic__Model=claude-3-5-sonnet-20241022
Anthropic__MaxTokens=20000

# 3. Autenticación y JWT (Mínimo 256 bits para HMAC-SHA256)
JWT_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_CRIPTO_DE_AL_MENOS_256_BITS_32_BYTES
Jwt__SecretKey=REEMPLAZAR_POR_UNA_CLAVE_CRIPTO_DE_AL_MENOS_256_BITS_32_BYTES
Authentication__Jwt__Secret=REEMPLAZAR_POR_UNA_CLAVE_CRIPTO_DE_AL_MENOS_256_BITS_32_BYTES
Authentication__Jwt__Issuer=Aukaria.Api
Authentication__Jwt__Audience=Aukaria.Web
Authentication__Jwt__DiasExpiracion=7

# 4. OAuth 2.0 Providers
Authentication__Google__ClientId=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
Authentication__Google__ClientSecret=TU_GOOGLE_CLIENT_SECRET
Authentication__Microsoft__ClientId=TU_MICROSOFT_CLIENT_ID
Authentication__Microsoft__ClientSecret=TU_MICROSOFT_CLIENT_SECRET
Authentication__RedirectToFrontend=http://localhost:5173

# 5. Configuración de Correo (Resend SMTP / API)
RESEND_API_KEY=re_TU_RESEND_API_KEY_AQUI
Email__Host=smtp.resend.com
Email__Port=587
Email__UseSsl=true
Email__Username=resend
Email__Password=re_TU_RESEND_API_KEY_AQUI
Email__FromEmail=notificaciones@mail.aukaria.com
Email__FromName="Aukaria Legal Tech"
