{"nodes": [{"id": "_claude_skills_systematic_debugging_skill", "label": "Systematic Debugging Skill (SKILL.md)", "file_type": "document", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_systematic_debugging_skill_iron_law", "label": "The Iron Law", "file_type": "rationale", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use ALWAYS/NEVER language (not should/try to) so the mandate 'NO FIXES WITHOUT ROOT CAUSE INVESTIGATION FIRST' resists rationalization under time pressure."}, {"id": "_claude_skills_systematic_debugging_skill_four_phases", "label": "The Four Phases", "file_type": "rationale", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4-phase systematic process (Investigation \u2192 Pattern Analysis \u2192 Hypothesis \u2192 Implementation) extracted from ~/.claude/CLAUDE.md; each phase must be completed before the next."}, {"id": "_claude_skills_systematic_debugging_skill_single_hypothesis_rule", "label": "Single Hypothesis Rule", "file_type": "rationale", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Form one specific hypothesis and test it with the smallest possible change (one variable at a time) to prevent shotgun fixes and isolate what worked."}, {"id": "_claude_skills_systematic_debugging_skill_question_architecture", "label": "Question Architecture (3+ Failed Fixes)", "file_type": "rationale", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3+ failed fixes each revealing new problems in different places indicates a wrong architecture, not a failed hypothesis; STOP and question fundamentals instead of attempting fix #4."}, {"id": "_claude_skills_systematic_debugging_skill_red_flags", "label": "Red Flags & Anti-Patterns", "file_type": "rationale", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most important bulletproofing: the anti-patterns section shows the exact shortcuts that feel justified in the moment; seeing 'I'll just add this one quick fix' listed as wrong creates cognitive friction."}, {"id": "_claude_skills_systematic_debugging_skill_root_cause_mandate", "label": "Root Cause Mandate", "file_type": "rationale", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALWAYS find root cause before fixes; symptom fixes are failure. Mandate repeated in overview, when_to_use, Phase 1, and implementation rules to resist rationalization."}, {"id": "superpowers_test_driven_development", "label": "superpowers:test-driven-development", "file_type": "concept", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "superpowers_verification_before_completion", "label": "superpowers:verification-before-completion", "file_type": "concept", "source_file": ".claude/skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_systematic_debugging_skill", "target": "_claude_skills_systematic_debugging_skill_iron_law", "relation": "references", "confidence": "EXTRACTED", "confide